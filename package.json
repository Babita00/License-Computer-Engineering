{
  "name": "fullstack-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Next.js + Express monorepo (single package, zero package.json inside src)",
  "scripts": {
    "dev": "concurrently \"pnpm dev:client\" \"pnpm dev:server\"",
    "dev:client": "next dev src/client -p 3000",
    "dev:server": "ts-node-dev --respawn --transpile-only src/server/main.ts",
    "build": "next build src/client && tsc --build",
    "start": "node dist/server/main.js",
    "lint": "next lint src/client && eslint src/server --ext .ts,.tsx"
  },
  "dependencies": {
    "app-root-path": "^3.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "next": "^15.5.6",
    "pg": "^8.16.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.27"
  },
  "devDependencies": {
    "@types/app-root-path": "^3.1.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.15 || ^15",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.2"
  },
  "packageManager": "pnpm@10.23.0"
}
